# Corelith website — environment
#
# Only server-side values belong here. Nothing prefixed NEXT_PUBLIC_ is used by
# this site, because nothing it does requires a secret in the browser bundle.

# Where project-intake submissions are delivered. Any endpoint that accepts a
# JSON POST works: an email relay, a CRM webhook, a Slack incoming webhook.
# Until this is set the intake route returns a clear message telling the visitor
# to email instead — it never reports a submission as delivered when it was not.
CORELITH_INTAKE_WEBHOOK=
