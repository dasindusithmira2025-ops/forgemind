# Git worktrees checked out inside the repository. Each holds a full source tree and its own
# Cargo target directory, so a stray `git add -A` would otherwise stage gigabytes of nested
# checkouts. `git worktree` tracks these through .git/worktrees, not the index.
.worktrees/

# Firebase deploy cache for the marketing site (regenerated on every deploy)
corelith-web/.firebase/
corelith-site/.firebase/

# Local tooling output (not part of the app source)
graphify-out
.claude/settings.local.json
.jcode/
.obsidian/
.paralith/
tmp/
media/exports/

# Obsidian project-intelligence vault: portable generated notes are tracked deliberately, while
# incremental caches and machine-specific workspace state stay local.
Paralith-Vault/00-System/.cache/
Paralith-Vault/.obsidian/workspace*.json
Paralith-Vault/.obsidian/cache/
Paralith-Vault/.trash/

