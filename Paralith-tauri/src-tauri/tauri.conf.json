{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PARALITH",
  "mainBinaryName": "PARALITH",
  "version": "0.4.4",
  "identifier": "com.corelith.paralith",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PARALITH",
        "create": false,
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* http://localhost:* ws://127.0.0.1:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Corelith Technologies",
    "copyright": "Copyright © 2026 Corelith Technologies",
    "shortDescription": "PARALITH multi-agent development workspace",
    "longDescription": "PARALITH is Corelith Technologies' native multi-agent terminal workspace for internal software development.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
