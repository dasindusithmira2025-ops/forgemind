{
  "name": "paralith",
  "private": true,
  "version": "0.4.16",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint src --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "visual": "vite --config vite.visual.config.ts",
    "vault": "node scripts/vault/cli.mjs",
    "vault:sync": "node scripts/vault/cli.mjs sync --repo ..",
    "vault:status": "node scripts/vault/cli.mjs status --repo ..",
    "vault:rebuild": "node scripts/vault/cli.mjs rebuild --repo ..",
    "vault:validate": "node scripts/vault/cli.mjs validate --repo ..",
    "vault:watch": "node scripts/vault/cli.mjs watch --repo ..",
    "vault:test": "node --test scripts/vault/*.test.mjs",
    "tauri": "tauri",
    "release:sync": "node scripts/release/sync-version.mjs",
    "release:check": "node scripts/release/sync-version.mjs --check",
    "release:config:stable": "node scripts/release/render-tauri-config.mjs stable local",
    "release:config:preview": "node scripts/release/render-tauri-config.mjs preview local",
    "build:stable": "node scripts/release/build-edition.mjs stable",
    "build:preview": "node scripts/release/build-edition.mjs preview",
    "release:assemble": "node scripts/release/assemble-release.mjs",
    "update-server": "node scripts/release/test-update-server.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.24.0",
    "monaco-editor": "0.54.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.12.1",
    "react-router-dom": "7.18.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "dompurify": "3.4.13"
  }
}
